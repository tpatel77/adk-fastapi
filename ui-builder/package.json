    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@foblex/2d": "1.2.2",
    "@foblex/flow": "17.9.81",
    "@foblex/mediator": "1.1.3",
    "@foblex/platform": "1.0.4",
    "@foblex/utils": "1.1.1",
    "monaco-editor": "^0.52.2",
    "ngx-monaco-editor-v2": "^20.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
